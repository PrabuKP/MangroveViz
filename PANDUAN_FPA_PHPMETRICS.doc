\f0\fs28 \cf0 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Panduan Functional Point Analysis dengan PHPLoc & PHPMetric\

\pard\pardeftab720\partightenfactor0
\fs24 \cf0 1. Persiapan Environment\
\pard\pardeftab720\partightenfactor0

\fs20 \cf0 Install PHP dan Composer\
\pard\pardeftab720\partightenfactor0

\f0\fs18 \cf0 # Ubuntu/Debian\
sudo apt update\
sudo apt install php-cli php-xml php-mbstring php-zip composer\
\
# macOS dengan Homebrew\
brew install php composer\
\
# Windows dengan Chocolatey\
choco install php composer\
\
\pard\pardeftab720\partightenfactor0
\fs20 \cf0 Install Tools Analisis\
\pard\pardeftab720\partightenfactor0

\f0\fs18 \cf0 # Via Composer (global)\
composer global require phploc/phploc\
composer global require phpmetrics/phpmetrics\
\
# Atau download PHAR files\
wget https://phar.phpunit.de/phploc.phar\
wget https://github.com/phpmetrics/PhpMetrics/releases/download/v2.4.1/phpmetrics.phar\
\
# Buat executable\
chmod +x phploc.phar phpmetrics.phar\
sudo mv phploc.phar /usr/local/bin/phploc\
sudo mv phpmetrics.phar /usr/local/bin/phpmetrics\
\
\pard\pardeftab720\partightenfactor0
\fs20 \cf0 Setup Project PHP\
\pard\pardeftab720\partightenfactor0

\f0\fs18 \cf0 # Buat project baru\
composer init\
\
# Atau untuk project existing\
cd /path/to/php/project\
composer require --dev phploc/phploc phpmetrics/phpmetrics\
\
\pard\pardeftab720\partightenfactor0
\fs24 \cf0 2. Penggunaan PHPLoc\
\pard\pardeftab720\partightenfactor0

\fs20 \cf0 Basic Usage\
\pard\pardeftab720\partightenfactor0

\f0\fs18 \cf0 # Analisis direktori\
phploc src/\
\
# Analisis dengan output JSON\
phploc --log-json=phploc.json src/\
\
# Analisis dengan progress bar\
phploc --progress src/\
\
# Exclude directories\
phploc --exclude=vendor --exclude=tests src/\
\
\pard\pardeftab720\partightenfactor0
\fs20 \cf0 Output PHPLoc\
PHPLoc memberikan metrics:\
\'95 Lines of Code (LOC): Total baris kode\
\'95 Cyclomatic Complexity: Kompleksitas siklomatik\
\'95 Number of Classes/Interfaces: Jumlah class dan interface\
\'95 Number of Methods: Jumlah method\
\'95 Code Coverage: Coverage testing\
\
\pard\pardeftab720\partightenfactor0
